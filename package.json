{
  "name": "gop-import",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "worker": "tsx worker/index.ts",
    "worker:dev": "tsx watch worker/index.ts",
    "test:e2e": "./tests/e2e.sh",
    "test:isolation": "./tests/isolation.sh",
    "test:images": "./tests/images-staging.sh",
    "test:cancel": "./tests/cancel.sh",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "worker:prod": "tsx --env-file=.env worker/index.ts",
    "db:migrate:prod": "tsx --env-file=.env db/migrate.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/lib-storage": "^3.700.0",
    "better-auth": "^1.6.0",
    "bullmq": "^5.34.0",
    "drizzle-orm": "^0.45.0",
    "ioredis": "^5.4.2",
    "next": "16.3.1",
    "papaparse": "^5.4.1",
    "postgres": "^3.4.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/papaparse": "^5.3.15",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4",
    "tsx": "^4.19.2",
    "typescript": "^5"
  },
  "packageManager": "pnpm@11.5.2"
}
